{
  "name": "frieren/crawler",
  "version": "1.0.0",
  "description": "Crawler management module for configuring crawl sources and dispatching crawler jobs.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Frieren\\Crawler\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Frieren\\Crawler\\Providers\\CrawlerServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
