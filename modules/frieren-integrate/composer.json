{
  "name": "frieren/integrate",
  "version": "1.0.0",
  "description": "Integration module for crawler events, RabbitMQ, inbox/outbox and webhooks.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "Frieren\\Integrate\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Frieren\\Integrate\\Providers\\IntegrateServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
